---
import { ArrowDownRight, ArrowUpRight } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import ProjectList from '../components/ProjectList.astro';
import OngoingProjects from '../components/OngoingProjects.astro';
import { site } from '../content';
---
<Layout title="ADITYA KUMAR — AI / ML / Developer" description={site.intro} current="home">
  <section class="hero">
    <div class="hero-top"><p class="eyebrow">Portfolio / 2026—27</p><p class="hero-note">Based in {site.location}<br />Available for interesting problems</p></div>
    <div class="hero-main">
      <div class="hero-copy"><p class="eyebrow accent-text">{site.eyebrow}</p><h1><span>Aditya</span><span class="indent">Kumar<sup>®</sup></span></h1><p class="hero-intro">{site.intro}</p><a class="round-link" href="#work" aria-label="Scroll to selected work"><ArrowDownRight size={24} /></a></div>
      <div class="hero-art"><div class="portrait-frame" tabindex="0"><img class="hero-portrait" src="/images/aditya-kumar.png" alt="Aditya Kumar wearing a black suit and tie" /><span class="portrait-popover"><b>HELLO</b><span>Aditya Kumar<br />AI / ML / Developer</span><i>↗</i></span></div></div>
    </div>
    <div class="scroll-cue"><span class="line"></span> Scroll to explore</div>
  </section>
  <Marquee />
  <section class="statement section-pad reveal"><p class="eyebrow">01 / Perspective</p><h2>I build intelligent tools that turn <em>complex ideas</em> into useful experiences.</h2></section>
  <section id="work" class="work section-pad"><div class="section-head"><div><p class="eyebrow">02 / What I’ve built</p><h2>What I’ve<br /><em>built.</em></h2></div><p class="section-side">A small selection of experiments, systems, and ideas. Always learning. Always shipping.</p></div><ProjectList /></section>
  <Marquee text="AI / ML / SOFTWARE / CREATIVE TECHNOLOGY" dark />
  <section class="home-about section-pad reveal"><div><p class="eyebrow">03 / A little about me</p><h2>Still figuring it out.<br /><em>That’s the fun part.</em></h2></div><div class="about-side"><p>Exploring the space between intelligent systems and human experiences. I like learning in public and making useful things from first principles.</p><a class="text-link" href="/about">More about me <ArrowUpRight size={16} /></a></div></section>
  <OngoingProjects />
</Layout>
