---
import { ArrowUpRight } from 'lucide-astro';
import { projects } from '../content';
import completedProjects from '../data/completed-projects.json';
const allProjects = [...projects, ...completedProjects];
---
<div class="project-list">
  {allProjects.map((project, index) => (
    <article class={`project-row reveal ${project.accent}`}>
      <div class="project-meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{project.year}</span></div>
      <div class={`project-visual ${project.accent}-visual`} aria-hidden="true">
        {project.accent === 'model' ? (
          <div class="text-model-scene" data-text-model>
            <canvas aria-label="Interactive visualization of a generative text model"></canvas>
            <span class="model-kicker">LANGUAGE SPACE / 01</span><span class="model-token token-top">create</span><span class="model-token token-left">learn</span><span class="model-token token-right">repeat</span><span class="model-token token-bottom">imagine</span>
            <span class="model-core-label">GENERATE<br /><b>∞</b></span>
          </div>
        ) : project.accent === 'voice' ? (
          <div class="voice-scene" data-voice-scene>
            <canvas aria-label="Interactive speech recognition waveform visualization"></canvas>
            <div class="voice-orb"><span></span></div>
            <div class="voice-ring voice-ring-one"></div><div class="voice-ring voice-ring-two"></div><div class="voice-ring voice-ring-three"></div>
            <span class="voice-kicker">VOICE INPUT / ACTIVE</span><span class="voice-transcript">listening<span>...</span></span>
          </div>
        ) : project.accent === 'summary' ? (
          <div class="summary-scene" data-summary-scene>
            <div class="document-sheet source-sheet"><span class="sheet-label">SOURCE TEXT / 842 WORDS</span><i></i><i></i><i></i><i></i><i></i><i></i></div>
            <div class="document-sheet summary-sheet"><span class="sheet-label">AI SUMMARY / 48 WORDS</span><strong>key ideas<br />extracted</strong><b></b><b></b><b></b></div>
            <div class="summary-orbit orbit-a"></div><div class="summary-orbit orbit-b"></div>
            <span class="summary-kicker">COMPRESS / CLARIFY</span><span class="summary-percent">94<span>%</span></span>
          </div>
        ) : (
          <><div class="visual-grid"></div><div class="visual-orbit"></div><div class="visual-core"></div></>
        )}
      </div>
      <div class="project-copy">
        <p class="eyebrow">Selected project / {String(index + 1).padStart(2, '0')}</p>
        <h3>{project.name}</h3>
        <p>{project.description}</p>
        <div class="project-foot"><div class="tag-list">{project.technologies.map((technology) => <span>{technology}</span>)}</div><a class="text-link" href={project.github} target="_blank" rel="noreferrer">View on GitHub <ArrowUpRight size={16} /></a></div>
      </div>
    </article>
  ))}
</div>
<script>
  const scenes = document.querySelectorAll('[data-text-model]');
  scenes.forEach((scene) => {
    const canvas = scene.querySelector('canvas');
    if (!canvas) return;
    const context = canvas.getContext('2d');
    if (!context) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    const particles = Array.from({ length: 34 }, (_, index) => ({
      x: (index * 47) % 100,
      y: (index * 71) % 100,
      depth: (index % 7) / 7,
      phase: index * 0.7,
    }));
    const render = (time = 0) => {
      const bounds = scene.getBoundingClientRect();
      const ratio = window.devicePixelRatio || 1;
      canvas.width = bounds.width * ratio;
      canvas.height = bounds.height * ratio;
      canvas.style.width = `${bounds.width}px`;
      canvas.style.height = `${bounds.height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, bounds.width, bounds.height);
      const centerX = bounds.width * 0.52 + pointerX * 16;
      const centerY = bounds.height * 0.5 + pointerY * 12;
      particles.forEach((particle, index) => {
        const drift = reduceMotion ? 0 : Math.sin(time / 1400 + particle.phase) * 8;
        const x = bounds.width * (particle.x / 100) + pointerX * particle.depth * 20;
        const y = bounds.height * (particle.y / 100) + drift + pointerY * particle.depth * 14;
        const distance = Math.hypot(x - centerX, y - centerY);
        if (distance < bounds.width * .42) {
          context.beginPath();
          context.moveTo(x, y);
          context.lineTo(centerX, centerY);
          context.strokeStyle = `rgba(255, 23, 68, ${Math.max(0.05, .32 - distance / bounds.width)})`;
          context.stroke();
        }
        context.beginPath();
        context.arc(x, y, 1.5 + particle.depth * 2, 0, Math.PI * 2);
        context.fillStyle = index % 5 === 0 ? '#ff1744' : '#ffffffaa';
        context.fill();
      });
      const glow = context.createRadialGradient(centerX, centerY, 8, centerX, centerY, bounds.width * .23);
      glow.addColorStop(0, '#ff174466'); glow.addColorStop(1, '#ff174400');
      context.fillStyle = glow; context.fillRect(0, 0, bounds.width, bounds.height);
      if (!reduceMotion) frame = requestAnimationFrame(render);
    };
    scene.addEventListener('pointermove', (event) => {
      const bounds = scene.getBoundingClientRect();
      pointerX = (event.clientX - bounds.left - bounds.width / 2) / bounds.width;
      pointerY = (event.clientY - bounds.top - bounds.height / 2) / bounds.height;
    });
    scene.addEventListener('pointerleave', () => { pointerX = 0; pointerY = 0; });
    render();
  });
  const voiceScenes = document.querySelectorAll('[data-voice-scene]');
  voiceScenes.forEach((scene) => {
    const canvas = scene.querySelector('canvas');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pointerX = 0;
    let pointerY = 0;
    const render = (time = 0) => {
      const bounds = scene.getBoundingClientRect();
      const ratio = window.devicePixelRatio || 1;
      canvas.width = bounds.width * ratio;
      canvas.height = bounds.height * ratio;
      canvas.style.width = `${bounds.width}px`;
      canvas.style.height = `${bounds.height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, bounds.width, bounds.height);
      const baseline = bounds.height * .74;
      const amplitude = bounds.height * .13;
      context.beginPath();
      for (let x = 0; x <= bounds.width; x += 4) {
        const wave = reduceMotion ? 0 : Math.sin(x * .075 + time / 320) * .45 + Math.sin(x * .19 + time / 520) * .22;
        const y = baseline + wave * amplitude + pointerY * 12;
        if (x === 0) context.moveTo(x, y); else context.lineTo(x, y);
      }
      context.strokeStyle = '#ff1744';
      context.lineWidth = 1.5;
      context.shadowBlur = 10;
      context.shadowColor = '#ff1744';
      context.stroke();
      context.shadowBlur = 0;
      for (let x = 0; x < bounds.width; x += 12) {
        const bar = 4 + Math.abs(Math.sin(x * .04 + time / 400)) * 26;
        context.fillStyle = '#ffffff44';
        context.fillRect(x, baseline + 18, 2, bar);
      }
      if (!reduceMotion) requestAnimationFrame(render);
    };
    scene.addEventListener('pointermove', (event) => {
      const bounds = scene.getBoundingClientRect();
      pointerX = (event.clientX - bounds.left - bounds.width / 2) / bounds.width;
      pointerY = (event.clientY - bounds.top - bounds.height / 2) / bounds.height;
      scene.style.setProperty('--voice-x', `${pointerX * 10}px`);
      scene.style.setProperty('--voice-y', `${pointerY * 10}px`);
    });
    scene.addEventListener('pointerleave', () => {
      pointerX = 0; pointerY = 0;
      scene.style.setProperty('--voice-x', '0px');
      scene.style.setProperty('--voice-y', '0px');
    });
    render();
  });
  const summaryScenes = document.querySelectorAll('[data-summary-scene]');
  summaryScenes.forEach((scene) => {
    scene.addEventListener('pointermove', (event) => {
      const bounds = scene.getBoundingClientRect();
      const x = (event.clientX - bounds.left - bounds.width / 2) / bounds.width;
      const y = (event.clientY - bounds.top - bounds.height / 2) / bounds.height;
      scene.style.setProperty('--summary-x', `${x * 18}px`);
      scene.style.setProperty('--summary-y', `${y * 14}px`);
    });
    scene.addEventListener('pointerleave', () => {
      scene.style.setProperty('--summary-x', '0px');
      scene.style.setProperty('--summary-y', '0px');
    });
  });
</script>
